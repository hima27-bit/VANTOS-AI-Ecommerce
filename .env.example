# VANTOS Configuration

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Qwen local inference server
QWEN_BASE_URL=http://127.0.0.1:8080
QWEN_MODEL=Qwen3-1.7B-Q4_K_M.gguf

# Product / vector database
PRODUCT_DATASET=products.csv
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=products

# Embedding model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5